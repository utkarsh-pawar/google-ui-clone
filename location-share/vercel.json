{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "rewrites": [{ "source": "/(.*)", "destination": "/$1" }],
  "crons": [
    { "path": "/api/cron", "schedule": "55 1 * * *"  },
    { "path": "/api/cron", "schedule": "55 6 * * *"  },
    { "path": "/api/cron", "schedule": "55 11 * * *" }
  ]
}
